+// upxPack compresses a Windows executable with the packer MYGO_UPX names, if
+// any, so the installer, archive and update carry the packed file.
+func upxPack(out string) error {
+	tool := os.Getenv("MYGO_UPX")
+	if tool == "" || !strings.EqualFold(filepath.Ext(out), ".exe") {
+		return nil
+	}
+	cmd := exec.Command(tool, "--best", "--lzma", out)
+	cmd.Stdout, cmd.Stderr = os.Stdout, os.Stderr
+	err := cmd.Run()
+	if err == nil {
+		return nil
+	}
+	var exit *exec.ExitError
+	if errors.As(err, &exit) && exit.ExitCode() == 2 {
+		return nil // UPX's warning: the file is still packed
+	}
+	return fmt.Errorf("upx %s: %w", filepath.Base(out), err)
+}
